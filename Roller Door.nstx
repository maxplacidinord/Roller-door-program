END_VAR

VAR 
  FB_Reset: MC_Reset;
  LeftEdge: R_TRIG;
  RightEdge: R_TRIG;
  RowIndex: INT;
END_VAR

VAR CONSTANT
  SelChar: STRING := >;
  ModChar: STRING := *;
END_VAR

VAR 
  IsParBoxOn: BOOL := 1;
  IsEditing: BOOL := 0;
  OkEdge: R_TRIG;
  IncTime: DINT := 500;
  IncTimer: TON;
  Inc: INT := 1;
  FlashTime: DINT := 1500;
  FlashTimer: TON;
  IncLvl: INT := 0;
  EditBuffer: DINT := 0;
END_VAR

VAR CONSTANT
  BlankString: STRING := '           ';
END_VAR

VAR 
  L1Enabled: BOOL := 1;
  L2Enabled: BOOL := 1;
  L3Enabled: BOOL := 1;
  L4Enabled: BOOL := 1;
  IsSaving: BOOL := 0;
  SavePar16: MC_WriteParameter_16;
  SavePar32: MC_WriteParameter_32;
  Line1Val: DINT;
  Line2Val: DINT;
  Line3Val: DINT;
  Line4Val: DINT;
  CurrentLineEnabled: BOOL := 0;
END_VAR

VAR CONSTANT
  EndChar: STRING := -;
  MidChar: STRING := |;
  UpArrowChar: STRING := ^;
  DownArrowChar: STRING := v;
END_VAR

