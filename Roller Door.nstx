(* @Variablen declarations *)
VAR_ACCESS 
  _5_State_digital_input: INT;
  _0_Set_digital_output: INT;
END_VAR

VAR 
  SetFreq: INT := 0;
  RunFreq: INT; (* ADJUSTABLE - Out of 16384 *)
  ClearFreq: INT; (* ADJUSTABLE *)
END_VAR

VAR_ACCESS 
  _90_Actual_torque_current: INT;
END_VAR

VAR 
  TorqueLimitUp: INT; (* ADJUSTABLE - Unit is deciamps *)
  TorqueLimitDown: INT; (* ADJUSTABLE - Unit is deciamps *)
  StartPos: DINT := 0; (* The start position is when the door is closed *)
  EndPos: DINT := 10000; (* Unit is millirevs | 1 Rev = 1000 *)
  TargetPos: DINT := 0;
END_VAR

VAR_ACCESS 
  _145_Actual_pos: DINT;
END_VAR

VAR 
  Init: BOOL := 0;
  State: INT := 1;
  FB_Power: MC_Power;
  FB_MoveAbs: MC_MoveAbsolute;
