(* @Program *)
(*
========================================================================================================================
 Project:       Roller Door PLC Program
 Description:   Automatic opening and closing with position control,
                jam detection, jam clearing, homing and PAR-5 HMI supported
 Author:        Max Placidi
 Version:       1.0
 Date:          20/07/2026

 Program Sections
 1. Jam detection     
 2. Loading parameters
 3. Parameter box display and information
 4. State machine
 5. Homing 
 6. Movement, power and current position assignment saving


 Revision history:
     1.0  20/07/2026  Initial release.
========================================================================================================================



REQUIRED TO ENABLE AUTO HOMING:
P480[09] = Reference point [23]
P481[09] = Output via PLC  [40]

ADJUSTABLE PARAMETERS:
P355[01] = Variable - RunFreq                                           [Test value: 2000]  Fraction out of 16384
P355[02] = Variable - ClearFreq                                         [Test value: 3500]  Fraction out of 16384
P355[03] = Variable - TorqueLimitUp                                     [Test value: 2]     Unit is deciamps
P355[04] = Variable - TorqueLimitDown                                   [Test value: 2]     Unit is deciamps
P355[05] = Variable - MaxJams                                           [Test value: 5]
P355[06] = Variable - HomeFreq                                          [Test value: 2000]  Fraction out of 16384
P355[07] = Variable - FloorDeadZone                                     [Test value: 100]   Unit is millirevs
P355[08] = Variable - TopDeadZone                                       [Test value: 100]   Unit is millirevs
P355[09] = Variable - HomingTorqueLimit                                 [Test value: 2]     Unit is deciamps

P356[01] = Last saved position. Loaded in during drive initialisation   [Test value: 100]   Unit is millirevs
P356[02] = Variable - EndPos                                            [Test value: 10000] Unit is millirevs
P356[03] = Variable - RestTime                                          [Test value: 2000]  Unit is milliseconds
P356[04] = Variable - JamTime                                           [Test value: 2000]  Unit is milliseconds

Assumes top sensor is digital input 5 
And bottom is         digital input 6

CONTROLS:
DI1 OR Parameter box up: Door open
DI2 OR Parameter box down: Force door closed OR Reference point during homing
DI5: Test jam signal
DI6 OR (Parameter box ok + Parameter box on): Initiate homing

ERRORS:
E23: Max jam clearing attempts reached.


*)

DI2Edge(CLK:=_5_State_digital_input.1);

(*Top sensor*)
DI5Edge(CLK:=_5_State_digital_input.4);

(*Bottom sensor*)
DI6Edge(CLK:=_5_State_digital_input.5);

(*0. -------Track Limit detection-------*)
IF NOT IsHoming THEN
        (*Exceeded Top*)
        IF DI5Edge.Q THEN
                _110_ErrorFlags.1 := TRUE;        
        END_IF;
        
        (*Exceeded bottom*)
        IF DI6Edge.Q THEN
                _110_ErrorFlags.2 := TRUE; 
        END_IF;
END_IF; 

(*1. ----------Jam detection------------*)                                                                                          
IF ((_90_Actual_torque_current > TorqueLimitUp) OR (_90_Actual_torque_current < -TorqueLimitDown)) AND NOT IsHoming AND Power THEN
        
        (*Jamming when opening*)
        IF ((State = 1)) THEN 
        
                JamTimer(IN:=FALSE);
                MoveExecute := FALSE;
                JamCount := JamCount + 1;
                State := 5; (*Clear jam after going up*)
        
        (*Jamming when clearing jam when opening*)        
        ELSIF ((State = 4) OR (State = 6)) AND (_90_Actual_torque_current > 0) THEN
                JamTimer(IN:=FALSE);
                MoveExecute := FALSE;
                JamCount := JamCount + 1;
                State := 6; (*Clear jam after clearing jam going up*)
                
        (*Jamming when closing*)        
        ELSIF (State = 3) AND (_90_Actual_torque_current < 0) THEN 
                JamCount := JamCount + 1;
                SetFreq := ClearFreq;
                MoveExecute := FALSE;
                Power := FALSE;
                                                
                State := 4; (*Clear jam after going down*)
        END_IF;          
END_IF;

(*2. ----------Loading parameters----------*)
IF NOT Init THEN
        (*Loading position*)
        EndPos := _126_PLC_P356_2;
        TargetPos := EndPos;
        MoveExecute := FALSE;
        Power := FALSE;

        (*Restores position from memory*)
        IF (_125_PLC_P356_1 > FloorDeadZone) AND (_125_PLC_P356_1 < (EndPos - TopDeadZone)) THEN
                ResetPos(
                        EXECUTE := TRUE, 
                        POSITION := _125_PLC_P356_1
                );                
        END_IF;
        
        (*Other presets*)
        RestTime :=  _127_PLC_P356_3;
        JamTime := _128_PLC_P356_4;
        
        RunFreq := _115_PLC_P355_1;
        ClearFreq := _116_PLC_P355_2;
        TorqueLimitUp := _117_PLC_P355_3;
        TorqueLimitDown := _118_PLC_P355_4;
        MaxJams := _119_PLC_P355_5;
        HomeFreq := _120_PLC_P355_6;
        FloorDeadZone := INT_TO_DINT(_121_PLC_P355_7);
        TopDeadZone := INT_TO_DINT(_122_PLC_P355_8);
        HomingTorqueLimit := _123_PLC_P355_9;

        Init := TRUE;
ELSE
        (*Writing position*)
        WritePos(
                EXECUTE := WritePosExecute AND (State <> 0),
                PARAMETERNUMBER := 356,
                PARAMETERINDEX := 0,
                VALUE := _145_Actual_pos,
                RAMONLY := 0
        );

        IF WritePos.Done OR WritePos.Error THEN
                WritePos(EXECUTE := FALSE);
        END_IF;
END_IF;

(*3. ----------Display and information------------*)


(*Defines moving from the running page to the parameter pages.*)
LeftEdge(CLK:=_72_Parameterbox_key_state.7);
RightEdge(CLK:=_72_Parameterbox_key_state.6);  

IF RightEdge.Q AND (Page <= 0) THEN
        Page := ABS(Page);
        ClearDisplay := TRUE;
END_IF;

IF LeftEdge.Q AND (Page >= 1) THEN
        Page := -ABS(Page);
        ClearDisplay := TRUE;
END_IF;

UpEdge(CLK := _72_Parameterbox_key_state.3);
DownEdge(CLK := _72_Parameterbox_key_state.4);
OkEdge(CLK:=_72_Parameterbox_key_state.5);


CASE Page OF                       
        1: (*Page 1*)
                (*
                        Line 1: Running frequency
                        Line 2: Frequency used to pull door up after encountering a jam going down.
                        Line 3: Torque current limit for faults going up
                        Line 4: Torque current limit for faults going down
                        
                *)
                
                (*First entry deploys label string*)                                                                                                    
                Display0(ENABLE := L1Enabled, CLEAR := ClearDisplay, ROW := 0,COLUMN := 0,
                        TEXT := RunFreqStr);
                (*Second entry deploys actual value*)  
                ParPageValue(ENABLE := L1Enabled, MODE := 0, ROW := 0, COLUMN := 12, POINT := 0, LENGTH := 6,
                        VALUE := INT_TO_DINT(RunFreq));
                (*Third entry is the end character to simulate a scroll bar*)
                Display0(ENABLE := TRUE, CLEAR := ClearDisplay, ROW := 0,COLUMN := 19,
                        TEXT := EndChar);
                
                (*Same for all 4 rows*)        
                Display1(ENABLE := L2Enabled, CLEAR := FALSE, ROW := 1, COLUMN := 0,
                        TEXT := ClearFreqStr);       
                ParPageValue(ENABLE := L2Enabled, MODE := 0, ROW := 1, COLUMN := 12, POINT := 0, LENGTH := 6,
                        VALUE := INT_TO_DINT(ClearFreq));
                Display1(ENABLE := TRUE, CLEAR := FALSE, ROW := 1, COLUMN := 19,
                        TEXT := MidChar);         
                        
                Display2(ENABLE := L3Enabled, CLEAR := FALSE, ROW := 2, COLUMN := 0,
                        TEXT := TorqueLimitUpStr);   
                ParPageValue(ENABLE := L3Enabled, MODE := 0, ROW := 2, COLUMN := 12, POINT := 0, LENGTH := 6,
                        VALUE := INT_TO_DINT(TorqueLimitUp));
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 2, COLUMN := 19,
                        TEXT := MidChar);        
                        
                Display3(ENABLE := L4Enabled, CLEAR := FALSE, ROW := 3, COLUMN := 0,
                        TEXT := TorqueLimitDownStr);       
                ParPageValue(ENABLE := L4Enabled, MODE := 0, ROW := 3, COLUMN := 12, POINT := 0, LENGTH := 6,
                        VALUE := INT_TO_DINT(TorqueLimitDown));
                Display3(ENABLE := TRUE, CLEAR := FALSE, ROW := 3, COLUMN := 19,
                        TEXT := DownArrowChar);
                                                                                                                                    
                Line1Val := INT_TO_DINT(RunFreq); 
                Line2Val := INT_TO_DINT(ClearFreq);
                Line3Val := INT_TO_DINT(TorqueLimitUp);
                Line4Val := INT_TO_DINT(TorqueLimitDown);      
                Line4Val := INT_TO_DINT(MaxJams); 
                               
        2: (*Page 2*)
                (*
                        Line 1: Maximum number of jams in a cycle before fault is thrown
                        Line 2: Frequency used during homing
                        Line 3: Floor dead zone
                        Line 4: Ceiling dead zone
                        
                *)
                
                
                (*First entry deploys label string*)                       
                Display0(ENABLE := L1Enabled,CLEAR := ClearDisplay,ROW := 0,COLUMN := 0,
                        TEXT := MaxJamsStr);
                (*Second entry deploys actual value*)                        
                ParPageValue(ENABLE := L1Enabled,MODE := 0,ROW := 0,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := INT_TO_DINT(MaxJams));
                (*Third entry is the end character to simulate a scroll bar*)        
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 0, COLUMN := 19,
                        TEXT := UpArrowChar);
                
                (*Same for all 4 rows*)  
                Display1(ENABLE := L2Enabled,CLEAR := FALSE,ROW := 1,COLUMN := 0,
                        TEXT := HomeFreqStr);        
                ParPageValue(ENABLE := L2Enabled,MODE := 0,ROW := 1,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := INT_TO_DINT(HomeFreq));
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 1, COLUMN := 19,
                        TEXT := MidChar);
                
                Display2(ENABLE := L3Enabled,CLEAR := FALSE,ROW := 2,COLUMN := 0,
                        TEXT := FloorDeadZoneStr);        
                ParPageValue(ENABLE := L3Enabled,MODE := 0,ROW := 2,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := FloorDeadZone);
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 2, COLUMN := 19,
                        TEXT := MidChar);
                
                Display3(ENABLE := L4Enabled,CLEAR := FALSE,ROW := 3,COLUMN := 0,
                        TEXT := TopDeadZoneStr);       
                ParPageValue(ENABLE := L4Enabled,MODE := 0,ROW := 3,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := TopDeadZone);
                Display3(ENABLE := TRUE, CLEAR := FALSE, ROW := 3, COLUMN := 19,
                        TEXT := DownArrowChar);
                
                Line1Val := INT_TO_DINT(MaxJams);
                Line2Val := INT_TO_DINT(HomeFreq); 
                Line3Val := FloorDeadZone;
                Line4Val := TopDeadZone;   
                
        3: (*Page 3*)
                (*
                        Line 1: Torque limit to mark reference point during homing
                        Line 2: End position (ceiling position in millirevolutions)
                        Line 3: Pause duration when reaching ceiling
                        Line 4: Time spent off after encountering a jam going up
                *)
        
                (*First entry deploys label string*)  
                Display0(ENABLE := L1Enabled,CLEAR := ClearDisplay,ROW := 0,COLUMN := 0,
                        TEXT := HomeTorqueLimitStr);
                (*Second entry deploys actual value*)                        
                ParPageValue(ENABLE := L1Enabled,MODE := 0,ROW := 0,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := INT_TO_DINT(HomingTorqueLimit));
                (*Third entry is the end character to simulate a scroll bar*)        
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 0, COLUMN := 19,
                        TEXT := UpArrowChar);
                
                Display1(ENABLE := L2Enabled,CLEAR := FALSE,ROW := 1,COLUMN := 0,
                        TEXT := EndPosStr);        
                ParPageValue(ENABLE := L2Enabled,MODE := 0,ROW := 1,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := EndPos);
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 1, COLUMN := 19,
                        TEXT := MidChar); 
                
                Display2(ENABLE := L3Enabled,CLEAR := FALSE,ROW := 2,COLUMN := 0,
                        TEXT := RestTimeStr);        
                ParPageValue(ENABLE := L3Enabled,MODE := 0,ROW := 2,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := RestTime);
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 2, COLUMN := 19,
                        TEXT := MidChar);
                
                Display3(ENABLE := L4Enabled,CLEAR := FALSE,ROW := 3,COLUMN := 0,
                        TEXT := JamTimeStr);       
                ParPageValue(ENABLE := L4Enabled,MODE := 0,ROW := 3,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := JamTime);
                Display0(ENABLE := TRUE, CLEAR := ClearDisplay, ROW := 3,COLUMN := 19,
                        TEXT := DownArrowChar);
                
                Line1Val := INT_TO_DINT(HomingTorqueLimit); 
                Line2Val := EndPos;
                Line3Val := RestTime;   
                Line4Val := JamTime;
        
        4: (*Page 4*)
                (*
                        Line 1: Saved position used to restore position in case of shutdown
                        Line 2: Blank
                        Line 3: Blank
                        Line 4: Blank
                *)
                
                Display0(ENABLE := L1Enabled,CLEAR := ClearDisplay,ROW := 0,COLUMN := 0,
                        TEXT := ActualPosStr);
                (*Second entry deploys actual value*)                        
                ParPageValue(ENABLE := L1Enabled,MODE := 0,ROW := 0,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := _125_PLC_P356_1);
                (*Third entry is the end character to simulate a scroll bar*)        
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 0, COLUMN := 19,
                        TEXT := UpArrowChar);
                
                Display1(ENABLE := L2Enabled,CLEAR := FALSE,ROW := 1,COLUMN := 0,
                        TEXT := BlankString);        
                ParPageValue(ENABLE := L2Enabled,MODE := 0,ROW := 1,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := 0);
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 1, COLUMN := 19,
                        TEXT := MidChar); 
                
                Display2(ENABLE := L3Enabled,CLEAR := FALSE,ROW := 2,COLUMN := 0,
                        TEXT := BlankString);        
                ParPageValue(ENABLE := L3Enabled,MODE := 0,ROW := 2,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := 0);
                Display2(ENABLE := TRUE, CLEAR := FALSE, ROW := 2, COLUMN := 19,
                        TEXT := MidChar);
                
                Display3(ENABLE := L4Enabled,CLEAR := FALSE,ROW := 3,COLUMN := 0,
                        TEXT := BlankString);       
                ParPageValue(ENABLE := L4Enabled,MODE := 0,ROW := 3,COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := 0);
                Display0(ENABLE := TRUE, CLEAR := ClearDisplay, ROW := 3,COLUMN := 19,
                        TEXT := EndChar);
                        
                        
                Line1Val := _125_PLC_P356_1;
                Line2Val := 0;
                Line3Val := 0;   
                Line4Val := 0;
ELSE                
        IsParBoxOn := TRUE;
                
        (*Parameterbox rows on the main operating page*)
        Display0(ENABLE := TRUE,CLEAR := ClearDisplay,ROW := 0,COLUMN := 0,TEXT := RunPageL0);
        Display1(ENABLE := TRUE,CLEAR := FALSE,ROW := 1,COLUMN := 0,TEXT := RunPageL1);
        Display2(ENABLE := TRUE,CLEAR := FALSE,ROW := 2,COLUMN := 0,TEXT := RunPageL2);
        Display3(ENABLE := TRUE,CLEAR := FALSE,ROW := 3,COLUMN := 0,TEXT := RunPageL0);
                                
        (*Row 3 position update*)
        PositionDisplay(ENABLE := TRUE,MODE := 0,ROW := 2,COLUMN := 3,POINT := 3,LENGTH := 8,
                VALUE := _145_Actual_pos);
        (*Row 3 state update*)
        StateDisplay(ENABLE := TRUE,MODE := 0,ROW := 2,COLUMN := 16,LENGTH := 2,
                VALUE := INT_TO_DINT(State));                
END_CASE;

ClearDisplay := FALSE;


(*Handles UI logic on the parameter page*)
IF Page > 0 THEN
        IsParBoxOn := FALSE;                  
        
        (*Detects the OK button press*)                                                                                                                                                        
        IF OkEdge.Q THEN
                (*If a value wasn't being edited before, that means the user wants to edit the selected value now*)
                IF IsEditing = FALSE THEN
                        IsEditing := TRUE;
                                                
                        CASE RowIndex OF
                                0: EditBuffer := Line1Val;
                                1: EditBuffer := Line2Val;
                                2: EditBuffer := Line3Val;
                                3: EditBuffer := Line4Val;
                        END_CASE; 
                                                  
                ELSE (*If a user was already editing a value, we then want the current value to save*)
                        IsEditing := FALSE;
                        L1Enabled := TRUE;
                        FlashTimer(IN:=FALSE);
                                                
                        (*Save Position*)
                        IsSaving := TRUE;
                                                
                        CASE RowIndex OF
                                0: Line1Val := EditBuffer;
                                1: Line2Val := EditBuffer;
                                2: Line3Val := EditBuffer;
                                3: Line4Val := EditBuffer;
                        END_CASE; 
                                                
                END_IF;        
        END_IF;
        
        (*User is adjusting parameter*)                
        IF IsEditing THEN
                (*Up button press condition*)
                IF _72_Parameterbox_key_state.3 THEN
                        
                        (*Rising edge immediately increments by 1*)
                        IF UpEdge.Q THEN
                                Inc := 0;
                                IncLvl := 1; 
                                EditBuffer := EditBuffer + 1;        
                        END_IF;
                        
                        (*Increases the size of the increment every time IncTime amount of time passes*)                        
                        IncTimer(IN:=TRUE,PT:=IncTime);                                
                        IF IncTimer.Q THEN
                                Inc := Inc + IncLvl; 
                                IncTimer(IN:=FALSE); 
                                                        
                                EditBuffer := EditBuffer + INT_TO_DINT(Inc);      
                        END_IF;
                        
                        (*Increases the size of the increment by x^2 + 5*)        
                        IF IncLvl MOD 5 = 0 THEN
                                IncLvl := IncLvl*IncLvl + 5;
                        END_IF;
                
                (*Down button press condition*)        
                ELSIF _72_Parameterbox_key_state.4 THEN
                
                        (*Rising edge immediately decrements by 1*)
                        IF DownEdge.Q THEN
                                Inc := 0;
                                IncLvl := 1;
                                EditBuffer := MAX(EditBuffer - 1, 0);        
                        END_IF;
                        
                        (*Increases the size of the increment every time IncTime amount of time passes*)                                                   
                        IncTimer(IN:=TRUE,PT:=IncTime);                                
                        IF IncTimer.Q THEN
                                Inc := Inc + IncLvl; 
                                IncTimer(IN:=FALSE);  
                                EditBuffer := MAX(EditBuffer - INT_TO_DINT(Inc),0);    
                        END_IF;   
                                                                    
                        
                        (*Increases the size of the increment by x^2 + 5*)        
                        IF IncLvl MOD 5 = 0 THEN
                                IncLvl := IncLvl*IncLvl + 5;
                        END_IF;
                ELSE
                        (*Resets incrementation upon release of buttons*)
                        IncTimer(IN:=FALSE);
                        Inc := 0;
                        IncLvl := 1;        
                END_IF;
                
                (*Adujsted new value is displayed*)                        
                ParPageValue(ENABLE := TRUE,MODE := 0,ROW := INT_TO_BYTE(RowIndex),COLUMN := 12,POINT := 0,LENGTH := 6,
                        VALUE := (EditBuffer));
                
               (*To let the user know editing mode is triggered, the name of the parameter is flashed at FlashTime*2 Hertz*)                                                   
                FlashTimer(IN:=NOT FlashTimer.Q, PT:=FlashTime);               
                IF FlashTimer.Q THEN
                        CASE RowIndex OF
                                0: CurrentLineEnabled := L1Enabled;
                                1: CurrentLineEnabled := L2Enabled;
                                2: CurrentLineEnabled := L3Enabled;
                                3: CurrentLineEnabled := L4Enabled;
                        END_CASE;
                        
                        (*Wipes the parameter name string to create flashing effect*)                        
                        IF CurrentLineEnabled THEN
                                LineInsert(ENABLE := TRUE,CLEAR := ClearDisplay,ROW := INT_TO_BYTE(RowIndex),COLUMN := 1,
                                TEXT := BlankString); 
                                CurrentLineEnabled := FALSE; 
                        ELSE
                                CurrentLineEnabled := TRUE;
                        END_IF;
                                                
                        CASE RowIndex OF
                                0: L1Enabled := CurrentLineEnabled;
                                1: L2Enabled := CurrentLineEnabled;
                                2: L3Enabled := CurrentLineEnabled;
                                3: L4Enabled := CurrentLineEnabled;
                        END_CASE;     
                END_IF;        
                                                                
        ELSE
                (*Scrolling functionality per row*)                
                CASE RowIndex OF
                        0:      
                                L1Enabled := TRUE;
                                IF UpEdge.Q AND (Page > 1) THEN
                                        RowIndex := 3; 
                                        Page := Page - 1;    
                                        ClearDisplay := TRUE;    
                                END_IF;
                                IF DownEdge.Q THEN
                                        RowIndex := RowIndex + 1;        
                                END_IF;
                                                        
                        1: 
                                L2Enabled := TRUE;
                                IF UpEdge.Q THEN
                                        RowIndex := RowIndex - 1;      
                                END_IF;
                                IF DownEdge.Q THEN
                                        RowIndex := RowIndex + 1;        
                                END_IF;
                        2: 
                                L3Enabled := TRUE;
                                IF UpEdge.Q THEN
                                        RowIndex := RowIndex - 1;      
                                END_IF;
                                IF DownEdge.Q THEN
                                        RowIndex := RowIndex + 1;        
                                END_IF;
                        3: 
                                L4Enabled := TRUE;
                                IF UpEdge.Q THEN
                                        RowIndex := RowIndex - 1;      
                                END_IF;
                                IF DownEdge.Q AND (Page < 4) THEN
                                        RowIndex := 0;
                                        Page := Page + 1; 
                                        ClearDisplay := TRUE;     
                                END_IF;
                END_CASE;
                                        
                FlashTimer(IN:=FALSE);
                                                                
        END_IF;
                                
        (*Inserts the '>' character on the selected row during scrolling, and '*' during editing mode*)
        IF NOT IsEditing THEN
                Display0(ENABLE := TRUE,CLEAR := FALSE,ROW := INT_TO_BYTE(RowIndex),COLUMN := 0,
                TEXT := SelChar);
        ELSE
                Display0(ENABLE := TRUE,CLEAR := FALSE,ROW := INT_TO_BYTE(RowIndex),COLUMN := 0,
                TEXT := ModChar);
        END_IF;
        
        
END_IF;

(*Parameter 355 indexes take 16 bit values. Those are on HMIPages 1 and 2*)
SavePar16(
        EXECUTE := IsSaving AND ((Page = 1) OR (Page = 2) OR ((Page = 3) AND (RowIndex = 0))) AND (State <> 0),
        PARAMETERNUMBER := 355,
        PARAMETERINDEX := (RowIndex + 4 * (Page - 1)),
        VALUE := DINT_TO_INT(EditBuffer),
        RAMONLY := 0
);   

(*Parameter 356 indexes take 32 bit values. Those are on HMIPage 3*)                        
SavePar32(
        EXECUTE := IsSaving AND (Page = 3) AND (State <> 0),
        PARAMETERNUMBER := 356,
        PARAMETERINDEX := RowIndex,
        VALUE := EditBuffer,
        RAMONLY := 0
);          

IF SavePar16.Done OR SavePar16.Error OR SavePar32.Done OR SavePar32.Error THEN
        IsSaving := FALSE;
        Init := FALSE;
END_IF;


(*4. ----------Drive state machine------------*)
CASE State OF   
        0: (*Homing*)
                IsBlocked := FALSE;                    
                _39_PLC_set_digital_output_bus.8 := FALSE;
                Power := TRUE;
                IsHoming := TRUE;  
                IsBlocked := (ABS(_90_Actual_torque_current) > HomingTorqueLimit);
                TorqueEdge(CLK:=IsBlocked);
                
                

                CASE HomingState OF 
                        
                        00: (*Homing begins upwards in the positive direction*)
                                IF ((DI5Edge.Q) OR ((UpEdge.Q OR DownEdge.Q OR OKEdge.Q) AND IsParBoxOn) 
                                OR (TorqueEdge.Q AND (_90_Actual_torque_current > 0))) 
                                AND (_88_Current_Speed >= 0) THEN
                                        _39_PLC_set_digital_output_bus.8 := TRUE;
                                
                                        EndPos := _145_Actual_pos;
                                
                                        HomingState := HomingState + 1; 
                                END_IF;  
                                
                        01: (*Homing ends downwards in the negative direction*)
                                IF ((DI6Edge.Q) OR ((UpEdge.Q OR DownEdge.Q OR OKEdge.Q) AND IsParBoxOn) 
                                OR (TorqueEdge.Q AND (_90_Actual_torque_current < 0))) THEN
                                        _39_PLC_set_digital_output_bus.8 := TRUE;
                                        
                                        EndPos := EndPos - _145_Actual_pos;
                                        StartPos := 0;
                        
                                        IF EndPos < (FloorDeadZone + TopDeadZone) THEN
                                                EndPos := FloorDeadZone + TopDeadZone;
                                        END_IF;
                        
                                        WritePos(EXECUTE:=FALSE);
                                        WritePos(
                                                EXECUTE := TRUE,
                                                PARAMETERNUMBER := 356,
                                                PARAMETERINDEX := 1,
                                                VALUE := EndPos,
                                                RAMONLY := 0);     
                                        
                                        HomingState := HomingState + 1;
                                END_IF;      
                END_CASE;
                
        1: (*Opening*)    
                IF Power AND NOT MoveExecute AND (TargetPos = EndPos) THEN
                        MoveExecute := TRUE;
                END_IF;

                IF (((_5_State_digital_input.0) OR (UpEdge.Q AND IsParBoxOn))) AND 
                (NOT ((_5_State_digital_input.1) OR (DownEdge.Q AND IsParBoxOn))) THEN
                        
                        TargetPos := EndPos;
                        SetFreq := RunFreq;     

                        IF NOT Power THEN
                                MoveExecute := FALSE;
                                Power := TRUE;
                        ELSE
                                MoveExecute := TRUE;
                        END_IF;
                END_IF;
                
                IF (FB_MoveAbs.Done) AND ((EndPos - _145_Actual_pos) < TopDeadZone) THEN 
                        Power := FALSE;
                        MoveExecute := FALSE; 
                        RestTimer(IN := FALSE);

                        State := 2; (*Reached top*)                       
                END_IF;
                
                IF ((_5_State_digital_input.1) OR (DownEdge.Q AND IsParBoxOn)) AND 
                (_145_Actual_pos > (StartPos + FloorDeadZone * 105/100)) THEN
                
                        RestTimer(IN := FALSE);
                        MoveExecute := FALSE;

                        State := 3; (*Closing*)
                END_IF;
        
        2: (*Reached top*)
                RestTimer(IN := TRUE, PT := RestTime);
                JamCount := 0;
                
                IF ((RestTimer.Q) OR ((_5_State_digital_input.1) OR (DownEdge.Q AND IsParBoxOn))) AND 
                NOT (_5_State_digital_input.0 OR (_72_Parameterbox_key_state.3 AND IsParBoxOn)) THEN
                        
                        RestTimer(IN := FALSE);
                        MoveExecute := TRUE; 
                        
                        State := 3; (*Closing*)
                END_IF;  
                                                  
        3: (*Closing*)
                TargetPos := StartPos;
                SetFreq := RunFreq;
                MoveExecute := TRUE;
        
                IF (_5_State_digital_input.0) OR (UpEdge.Q AND IsParBoxOn) THEN                        
                
                        TargetPos := EndPos;
                        MoveExecute := FALSE; 
                        SetFreq := RunFreq;
                        
                        State := 1;
                ELSE
                        Power := TRUE;
                END_IF; 

                                   
                IF ((FB_MoveAbs.Done) AND ((_145_Actual_pos - StartPos) < FloorDeadZone)) THEN 
                        Power := FALSE;
                        
                        IF ((NOT _5_State_digital_input.1) OR (NOT (DownEdge.Q AND IsParBoxOn))) THEN
                                MoveExecute := FALSE;
                                JamCount := 0;
                                Init := FALSE;
                                State := 1; (*Opening*) 
                        END_IF;
                END_IF;
                
        4: (*ERROR STATE 1: Clear jam when going down*)
                IF NOT Power THEN
                        Power := TRUE;
                ELSE
                        MoveExecute := TRUE;
                END_IF;

                TargetPos := EndPos;
                SetFreq := ClearFreq;      
                                                                
                IF (FB_MoveAbs.Done) THEN
                
                        MoveExecute := FALSE;
                        State := 3; (*Closing*)       
                END_IF;        
                
        5: (*ERROR STATE 2: Clear jam when going up*)
                JamTimer(IN:=TRUE, PT:=JamTime);
                Power := FALSE;
                MoveExecute := FALSE;
                
                IF JamTimer.Q THEN                    
                        Power := TRUE;
                        MoveExecute := TRUE;
                        JamTimer(IN:=FALSE);  
                        
                        State := 1;        
                END_IF;
                
        6: (*ERROR STATE 3: Clear jam when clearing jam going up*) 
                JamTimer(IN:=TRUE, PT:=JamTime);
                Power := FALSE;
                MoveExecute := FALSE;

                IF JamTimer.Q THEN    
                        TargetPos := EndPos;
                        SetFreq := ClearFreq;      
                        Power := TRUE;  
                        MoveExecute := TRUE;
                                                                                                    
                        IF (FB_MoveAbs.Done) THEN
                                JamTimer(IN:=FALSE);  
                                MoveExecute := FALSE;
                                State := 3; (*Closing*)       
                        END_IF;     
                END_IF;
END_CASE;

IF _72_Parameterbox_key_state.1 THEN
        _110_ErrorFlags.0 := FALSE;
        _110_ErrorFlags.1 := FALSE;
        _110_ErrorFlags.2 := FALSE;
        
        FB_MoveAbs(EXECUTE:= FALSE);
        Power := TRUE; 
        IsHoming := FALSE; 
        MoveExecute := FALSE;
        
        Init := FALSE;
        JamCount := 0;   
        State := 1;
                            
END_IF; 

IF JamCount >= MaxJams THEN
        _110_ErrorFlags.0 := TRUE;     
END_IF;

FB_Reset(EXECUTE := _72_Parameterbox_key_state.1);
 
(*5. -----------Homing handling--------------*)
IF (_72_Parameterbox_key_state.0  AND _72_Parameterbox_key_state.5 AND IsParBoxOn)
AND (State = 1) AND (_88_Current_speed = 0) THEN
        Power := TRUE;
        HomingState := 0;
        IsHoming := TRUE;
        State := 0;
        
        MoveExecute := FALSE;
END_IF;                                

IF FB_Home.Done THEN
        IsHoming := FALSE;
        IsBlocked := FALSE;
       
        MoveExecute := FALSE;
        Power := FALSE;
        Init := FALSE;
        
        State := 1;
END_IF;

IF FB_Home.Error THEN
        IsHoming := FALSE;
        Power := FALSE;
        Init := FALSE;
        State := 1;
END_IF;

(*6. -----------Movement, power and current position saving----------*)
IF Power THEN
        FB_Power(ENABLE:=TRUE);
ELSE
        FB_Power(ENABLE:=FALSE);
        
        IF (_145_Actual_pos <= FloorDeadZone) THEN
                Init := FALSE;
        END_IF;
END_IF;

IF FB_Power.Status THEN
        FB_MoveAbs(
                EXECUTE := MoveExecute AND Power AND FB_Power.Status AND NOT IsHoming, 
                POSITION := TargetPos, 
                VELOCITY := SetFreq, 
                MODE := 0
        );
        
        FB_Home(EXECUTE:=IsHoming,
                POSITION := 0,
                VELOCITY := HomeFreq,
                MODE := 16
        ); 
        
        WritePosExecute := TRUE;
END_IF;
]]></Program><Checksum>E2368A0F6FB9F78345337DD1C37F14CBC247793E5B10F0C23409BCC6</Checksum></PLCFile></NordCon>
