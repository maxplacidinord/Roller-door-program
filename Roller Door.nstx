  _116_PLC_P355_2: INT; (* ClearFreq *)
  _117_PLC_P355_3: INT; (* TorqueLimit *)
  _118_PLC_P355_4: INT; (* MaxJams *)
  _119_PLC_P355_5: INT; (* HomeFreq *)
