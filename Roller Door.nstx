  MaxJams: INT; (* ADJUSTABLE *)
END_VAR

VAR_ACCESS 
  _110_ErrorFlags: BYTE;
  _88_Current_speed: INT;
END_VAR

VAR 
  FloorDeadZone: DINT; (* ADJUSTABLE *)
  TopDeadZone: DINT; (* ADJUSTABLE *)
  JamTimer: TON;
  JamTime: DINT; (* ADJUSTABLE *)
  Power: BOOL := 0;
END_VAR

VAR_ACCESS 
  _72_Parameterbox_key_state: BYTE;
END_VAR

VAR 
  Page: INT := -1;
  LineInsert: FB_StringToPBox;
  Display0: FB_StringToPBox;
  Display1: FB_StringToPBox;
  Display2: FB_StringToPBox;
  Display3: FB_StringToPBox;
  PositionDisplay: FB_DINTToPBox;
  StateDisplay: FB_DINTToPBox;
END_VAR

VAR CONSTANT
  RunPageL0: STRING := ------------------------;
  RunPageL1: STRING := | NORD Roller Door |;
  RunPageL2: STRING := |P:12345678 | S: 3 |;
  RunFreqStr: STRING := ' RunFreq';
  ClearFreqStr: STRING := ' ClearFreq';
  TorqueLimitUpStr: STRING := ' TorqueLimUp';
  TorqueLimitDownStr: STRING := ' TorqueLimDo';
  MaxJamsStr: STRING := ' MaxJams';
  HomeFreqStr: STRING := ' HomingFreq';
  FloorDeadZoneStr: STRING := ' FloorDeadZone';
  TopDeadZoneStr: STRING := ' TopDeadZone';
  HomeTorqueLimitStr: STRING := ' HomeTorqueLimit';
  RestTimeStr: STRING := ' RestTime';
  JamTimeStr: STRING := ' JamTime';
  EndPosStr: STRING := ' EndPos';
  ActualPosStr: STRING := ' SavedPos';
END_VAR

VAR 
  ParPageValue: FB_DINTToPBox;
  FB_Home: MC_Home;
  HomeFreq: INT; (* ADJUSTABLE *)
  IsHoming: BOOL := 0;
  UpEdge: R_TRIG;
  DownEdge: R_TRIG;
  DI2Edge: R_TRIG;
  DI5Edge: R_TRIG;
  DI6Edge: R_TRIG;
  TorqueEdge: R_TRIG;
